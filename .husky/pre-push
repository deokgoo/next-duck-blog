#!/bin/sh
# Block direct pushes to main — all changes go through PRs.
# Reads refs from stdin: <local ref> <local sha> <remote ref> <remote sha>
while read local_ref local_sha remote_ref remote_sha; do
  # local branch name (strip refs/heads/)
  branch="${local_ref#refs/heads/}"
  # remote branch name (strip refs/heads/)
  remote_branch="${remote_ref#refs/heads/}"

  if [ "$branch" = "main" ] || [ "$remote_branch" = "main" ]; then
    echo ""
    echo "✖  main 브랜치에 직접 push할 수 없습니다."
    echo "   feature 브랜치로 push하고 PR을 만들어 주세요."
    echo "   (예: git push origin feat/your-branch)"
    echo ""
    exit 1
  fi
done
exit 0
